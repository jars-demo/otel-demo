# Optional overrides for docker-compose.yml. Copy to .env and change what you need:
#   cp .env.example .env
# Every value below is the default; the lab needs no .env file at all.
# Host ports (all bound to 127.0.0.1). Change one if it is already in use on your machine.

WEB_PORT=3400          # the website with the live views
GATEWAY_PORT=8400      # api-gateway (the shop API, /docs for Swagger UI)
LAB_PORT=8410          # lab-console (faults, incidents, telemetry queries)
GRAFANA_PORT=3401      # Grafana
PROMETHEUS_PORT=9090   # Prometheus
TEMPO_PORT=3200        # Tempo HTTP API
LOKI_PORT=3100         # Loki HTTP API
OTLP_GRPC_PORT=4317    # Collector OTLP/gRPC, for programs on your machine
OTLP_HTTP_PORT=4318    # Collector OTLP/HTTP, for programs on your machine
